# ---------------------------------------------------------------------------
# healthOS configuration template.
#
# Copy to `.env` and fill in only what you need:
#
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored. Every key below has a working default, so an empty
# `.env` still produces a full local run: the studio falls back to deterministic
# offline research and Windows SAPI narration rather than refusing to start.
#
# Nothing in this file is a real credential.
# ---------------------------------------------------------------------------

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE=on
# LOG_DIR=logs

# --- Storage ----------------------------------------------------------------
# DATABASE_URL=sqlite:data/healthos.db
# DATABASE_PATH=data/healthos.db
# REDIS_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ARCHIVE_BUCKET=

# --- AI providers (optional; local deterministic fallbacks when unset) ------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_PROVIDER=none
# LLM_MODEL=
# LLM_BASE_URL=

# --- Research providers -----------------------------------------------------
# PUBMED_API_KEY=
# NCBI_API_KEY=
EUROPE_PMC_ENABLED=true
# SERPAPI_API_KEY=
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
GOOGLE_TRENDS_ENABLED=false
# RSS_FEEDS=

# --- Stock and asset providers ---------------------------------------------
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=
ASSET_PROVIDER=none

# --- Voice ------------------------------------------------------------------
# "auto" uses Windows SAPI locally, which is what the measured timing model is
# calibrated against. A remote TTS provider needs its own timing measurement.
TTS_PROVIDER=auto
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=
TTS_VOICE=default
# VOICE_DIR=
# SPEECH_RATE=0
SYNTHETIC_MEDIA_DISCLOSURE=AI-generated narration and motion graphics

# --- Rendering --------------------------------------------------------------
RENDER_ENGINE=html
RENDER_CONCURRENCY=2
RENDER_FPS=30
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_JPEG_QUALITY=95
RENDER_SEEK_TIMEOUT_MS=30000
# RENDER_BROWSER_PATH=
HEADLESS=true

# --- Production targets -----------------------------------------------------
DAILY_TARGET=5
TARGET_DURATION_SECONDS=42
MIN_DURATION_SECONDS=30
MAX_DURATION_SECONDS=60
PUBLISH_MODE=AUTO_PUBLISH_AFTER_ALL_GATES
PUBLISH_DRY_RUN=true
BATCH_PUBLISH=true
ANALYTICS_ENABLED=true

# --- Platforms (leave empty to keep publishing disabled) -------------------
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# YOUTUBE_ACCESS_TOKEN=
# YOUTUBE_CHANNEL_ID=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_OPEN_ID=
# YOUTUBE_CREDENTIALS_FILE=

# --- Dashboard --------------------------------------------------------------
DASHBOARD_PORT=4785
DASHBOARD_HOST=127.0.0.1

# --- Continuous loop --------------------------------------------------------
LOOP_ENABLED=false
LOOP_INTERVAL_SECONDS=120
TEMP_RETENTION_HOURS=6
