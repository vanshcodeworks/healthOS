{
  "name": "health-content-os",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous short-form health-science content studio: discovery, research, script, storyboard, motion design, render, QA, rights, publishing, analytics.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "healthos": "apps/cli/bin/healthos.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:migrate": "node apps/cli/bin/healthos.mjs db migrate",
    "healthos": "node apps/cli/bin/healthos.mjs",
    "demo": "node apps/cli/bin/healthos.mjs batch run --count 3",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/bundler": "^4.0.529",
    "@remotion/paths": "^4.0.529",
    "@remotion/player": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "playwright": "^1.49.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.1"
  }
}
